    "@agent-colosseum/protocol": "workspace:*",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.5.0",
    "ioredis": "^5.7.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
