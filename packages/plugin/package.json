{
  "name": "agent-colosseum",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "description": "DSH plugin: heads-up agent Texas Hold'em and model-call grants.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/index.d.ts",
    "lib/client.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/build-plugin.mjs",
    "build": "node ../../scripts/build-plugin.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@agent-colosseum/crypto": "workspace:*",
    "@agent-colosseum/poker": "workspace:*",
    "@agent-colosseum/protocol": "workspace:*",
    "@types/react": "^19.1.8",
    "esbuild": "^0.25.9",
    "react": "^19.1.0",
    "typescript": "^5.9.2",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.7",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "react": { "optional": true }
  }
}
