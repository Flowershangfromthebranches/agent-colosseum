{
  "name": "agent-colosseum-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm --filter agent-colosseum build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r --filter \"./packages/**\" run typecheck",
    "lint": "oxlint packages",
    "format:check": "oxlint --deny-warnings packages",
    "pack:plugin": "pnpm --dir packages/plugin pack --pack-destination ../.."
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.9",
    "oxlint": "^1.12.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
