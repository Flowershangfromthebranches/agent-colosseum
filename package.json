{
  "name": "agent-colosseum-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm --filter agent-colosseum build && pnpm --filter @agent-colosseum/server exec tsc -p tsconfig.build.json --noEmit false || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r --filter \"./packages/**\" run typecheck",
    "lint": "oxlint packages",
    "format:check": "oxfmt --check packages || true",
    "pack:plugin": "pnpm --filter agent-colosseum pack",
    "server": "pnpm --filter @agent-colosseum/server start",
    "migrate": "pnpm --filter @agent-colosseum/server migrate"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.9",
    "oxlint": "^1.12.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
