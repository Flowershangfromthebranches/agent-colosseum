FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* .npmrc ./
COPY packages ./packages
RUN pnpm install --frozen-lockfile=false --filter @agent-colosseum/server... --config.strict-dep-builds=false
RUN node --input-type=module -e "import {build} from 'esbuild'; await build({entryPoints:['packages/server/src/main.ts'],outfile:'packages/server/dist/main.cjs',bundle:true,platform:'node',format:'cjs',target:'node22'});"

FROM node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/packages/server/dist/main.cjs /app/main.cjs
COPY --from=build /app/packages/server/src/schema.sql /app/schema.sql
EXPOSE 8787
USER node
CMD ["node", "main.cjs"]
