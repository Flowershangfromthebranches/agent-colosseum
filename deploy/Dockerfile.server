FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages ./packages
RUN pnpm install --frozen-lockfile=false --filter @agent-colosseum/server...
RUN pnpm --filter @agent-colosseum/server exec tsc -p tsconfig.json --noEmit || true
# Production image runs compiled JS via node --experimental-strip-types on the published src tree
# after esbuild bundle:
RUN node --input-type=module -e "import {build} from 'esbuild'; await build({entryPoints:['packages/server/src/main.ts'],outfile:'packages/server/dist/main.js',bundle:true,platform:'node',format:'esm',target:'node22',packages:'external'});"

FROM node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/packages/server/dist/main.js /app/main.js
COPY --from=build /app/packages/server/src/schema.sql /app/schema.sql
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/packages /app/packages
EXPOSE 8787
USER node
CMD ["node", "main.js"]
